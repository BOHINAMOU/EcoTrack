@model List<EcoTrack.Models.Employe>
@{
    ViewData["Title"] = "Nommer un admin temporaire";
    var idsDejaAdminTemporaire = (HashSet<string>)ViewBag.IdsDejaAdminTemporaire;
    var terme = (string?)ViewBag.Terme;
}

<div class="mb-3 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h3 class="mb-0">Nommer un administrateur temporaire</h3>
        <p class="text-muted mb-0">
            La personne désignée bénéficie des privilèges de l’administrateur principal ainsi que d’un espace employé. Si elle ne dispose pas encore d’un compte, celui-ci est créé automatiquement et ses identifiants lui sont transmis par email.

        </p>
    </div>
    <a asp-action="CreerTemporaire" class="btn btn-outline-primary text-nowrap">
        <i class="bi bi-person-plus"></i> Nouveau compte temporaire
    </a>
</div>

<form method="get" class="mb-3 d-flex" style="max-width: 420px; gap: 0.5rem;">
    <input type="text" name="terme" value="@terme" class="form-control" placeholder="Rechercher un employé (nom ou email)" />
    <button type="submit" class="btn btn-outline-secondary">Rechercher</button>
</form>

<div class="table-responsive-wrapper">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom complet</th>
                <th>Email</th>
                <th>Agence</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employe in Model)
            {
                var dejaAdminTemporaire = employe.ApplicationUserId is not null && idsDejaAdminTemporaire.Contains(employe.ApplicationUserId);

                <tr>
                    <td>@employe.Prenom @employe.Nom</td>
                    <td>@employe.Email</td>
                    <td>@employe.Agence?.Nom</td>
                    <td class="text-end">
                        @if (dejaAdminTemporaire)
                        {
                            <span class="badge bg-warning text-dark">Déjà admin temporaire</span>
                        }
                        else
                        {
                            <form asp-action="Nommer" method="post" class="d-inline"
                                  onsubmit="return confirm('Nommer @employe.Prenom @employe.Nom administrateur temporaire ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="employeId" value="@employe.Id" />
                                <button type="submit" class="btn btn-sm btn-primary">Nommer admin temporaire</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-muted">Aucun employé trouvé.</td>
                </tr>
            }
        </tbody>
    </table>
</div>