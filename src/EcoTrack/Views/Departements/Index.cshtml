@model IEnumerable<EcoTrack.Models.Departement>
@{
    ViewData["Title"] = "Départements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Départements / agences</h3>
        <p class="text-muted mb-0">@Model.Count() département(s) enregistré(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nouveau département
    </a>
</div>

<div class="table-responsive-wrapper">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Code</th>
                <th>Localisation</th>
                <th>Employés</th>
                <th>Actifs</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var departement in Model)
            {
                <tr class="@(!departement.EstActif ? "table-secondary" : "")">
                    <td>
                        <a asp-action="Details" asp-route-id="@departement.Id">@departement.Nom</a>
                    </td>
                    <td>@departement.Code</td>
                    <td>@departement.Localisation</td>
                    <td>@departement.Employes.Count</td>
                    <td>@departement.Actifs.Count</td>
                    <td>
                        @if (departement.EstActif)
                        {
                            <span class="badge bg-success">Actif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Désactivé</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@departement.Id" class="btn btn-sm btn-outline-secondary">Détails</a>
                        <a asp-action="Edit" asp-route-id="@departement.Id" class="btn btn-sm btn-outline-primary">Renommer</a>
                        <form asp-action="BasculerActivation" asp-route-id="@departement.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (departement.EstActif)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Réactiver</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aucun département enregistré pour l'instant.</p>
}