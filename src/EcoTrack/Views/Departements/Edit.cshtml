@model EcoTrack.Models.Departement

@{
    ViewData["Title"] = "Modifier le département";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Modifier le département</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nom" class="form-label"></label>
                    <input asp-for="Nom" class="form-control" />
                    <span asp-validation-for="Nom"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AgenceId" class="form-label">
                        Agence
                    </label>

                    <select asp-for="AgenceId"
                            class="form-select"
                            asp-items="ViewBag.AgenceId">
                        <option value="">-- Sélectionner une agence --</option>
                    </select>

                    <span asp-validation-for="AgenceId"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="EstActif"
                           class="form-check-input" />

                    <label asp-for="EstActif"
                           class="form-check-label">
                    </label>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-save"></i>
                    Enregistrer
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Annuler
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}