@model EcoTrack.Models.Departement
@{
    ViewData["Title"] = "Détails du département";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@Model.Nom</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>
<p class="text-muted">Agence : @Model.Agence?.Nom</p>

<h5 class="mb-3">Divisions (@Model.Divisions.Count)</h5>
<ul class="list-group">
    @foreach (var division in Model.Divisions)
    {
        <li class="list-group-item">
            <a asp-controller="Divisions" asp-action="Details" asp-route-id="@division.Id">@division.Nom</a>
        </li>
    }
    @if (!Model.Divisions.Any())
    {
        <li class="list-group-item text-muted">Aucune division dans ce département.</li>
    }
</ul>