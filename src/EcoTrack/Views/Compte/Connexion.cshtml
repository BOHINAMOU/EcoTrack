@model EcoTrack.ViewModels.ConnexionViewModel
@{
    ViewData["Title"] = "Connexion";
    Layout = null; // Layout épuré dédié à la connexion sans la navbar classique
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoTrack | Ecobank Asset Management</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Polices Google Font (Inter / Segoe UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                font-family: 'Inter', system-ui, -apple-system, sans-serif;
            }

            /* Arrière-plan style Corporate Bank avec Overlay Gradient Bleu */
            body, html {
                height: 100%;
                margin: 0;
                overflow-x: hidden;
            }

            .bg-login-container {
                min-height: 100vh;
                background: linear-gradient(135deg, rgba(0, 48, 87, 0.90) 0%, rgba(0, 75, 135, 0.85) 50%, rgba(0, 24, 48, 0.95) 100%),
                            url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }

            /* Form d'effet Verre Dépoli (Glassmorphism) */
            .login-card {
                background: rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border: 1px solid rgba(255, 255, 255, 0.18);
                border-radius: 16px;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
                color: #ffffff;
                width: 100%;
                max-width: 440px;
            }

            /* Champs personnalisés transparents */
            .form-control-custom {
                background: rgba(255, 255, 255, 0.12) !important;
                border: 1px solid rgba(255, 255, 255, 0.25) !important;
                color: #ffffff !important;
                border-radius: 8px;
                padding: 12px 16px;
                font-size: 0.95rem;
                transition: all 0.3s ease;
            }

            .form-control-custom::placeholder {
                color: rgba(255, 255, 255, 0.55);
            }

            .form-control-custom:focus {
                background: rgba(255, 255, 255, 0.2) !important;
                border-color: #00A3E0 !important;
                box-shadow: 0 0 0 0.25rem rgba(0, 163, 224, 0.25) !important;
                color: #ffffff !important;
            }

            .input-group-text-custom {
                background: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-right: none;
                color: rgba(255, 255, 255, 0.75);
                border-top-left-radius: 8px;
                border-bottom-left-radius: 8px;
            }

            .input-group .form-control-custom {
                border-top-left-radius: 0 !important;
                border-bottom-left-radius: 0 !important;
            }

            .btn-toggle-pw {
                background: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-left: none;
                color: rgba(255, 255, 255, 0.75);
                border-top-right-radius: 8px;
                border-bottom-right-radius: 8px;
            }
            .btn-toggle-pw:hover {
                color: #ffffff;
                background: rgba(255, 255, 255, 0.2);
            }

            /* Bouton Action Ecobank Cyan / Navy */
            .btn-ecobank {
                background: linear-gradient(90deg, #00A3E0 0%, #0072CE 100%);
                border: none;
                color: #ffffff;
                font-weight: 600;
                padding: 12px;
                border-radius: 8px;
                letter-spacing: 0.5px;
                transition: all 0.3s ease;
            }

            .btn-ecobank:hover {
                background: linear-gradient(90deg, #008cc0 0%, #005fb0 100%);
                color: #ffffff;
                box-shadow: 0 8px 20px rgba(0, 163, 224, 0.4);
                transform: translateY(-1px);
            }

            .brand-logo-text {
                font-size: 1.8rem;
                font-weight: 700;
                letter-spacing: -0.5px;
            }

            .badge-eco {
                background: rgba(0, 163, 224, 0.2);
                color: #00D1FF;
                border: 1px solid rgba(0, 209, 255, 0.4);
                font-weight: 500;
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 0.75rem;
            }
    </style>
</head>
<body>

    <div class="bg-login-container px-3">
        <div class="login-card p-4 p-sm-5">

            <!-- Header / Identité visuelle Ecobank -->
            <div class="text-center mb-4">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                    <span class="brand-logo-text text-white"> EcoTrack - Ecobank</span>
                </div>
                <h4 class="fw-bold mb-1">EcoTrack</h4>
                <p class="text-white-50 small">Système d'Accès et  Gestion des Actifs</p>
            </div>

            <form asp-action="Connexion" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-danger text-white bg-opacity-75 p-2 small mb-3 rounded-3" role="alert"></div>

                <!-- Identifiant -->
                <div class="mb-3">
                    <label asp-for="NomUtilisateur" class="form-label text-white-50 small fw-medium">Nom d'utilisateur </label>
                    <div class="input-group">
                        <span class="input-group-text input-group-text-custom"><i class="bi bi-person-fill"></i></span>
                        <input asp-for="NomUtilisateur" class="form-control form-control-custom" autocomplete="username" placeholder="Ex: utilisateur.ecobank" />
                    </div>
                    <span asp-validation-for="NomUtilisateur" class="text-warning small mt-1 d-block"></span>
                </div>

                <!-- Mot de passe -->
                <div class="mb-3">
                    <label asp-for="MotDePasse" class="form-label text-white-50 small fw-medium">Mot de passe</label>
                    <div class="input-group">
                        <span class="input-group-text input-group-text-custom"><i class="bi bi-shield-lock-fill"></i></span>
                        <input asp-for="MotDePasse" id="passwordInput" type="password" class="form-control form-control-custom" autocomplete="current-password" placeholder="••••••••" />
                        <button class="btn btn-toggle-pw" type="button" id="togglePassword">
                            <i class="bi bi-eye-fill" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MotDePasse" class="text-warning small mt-1 d-block"></span>
                </div>

                <!-- Se souvenir de moi -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="SeSouvenirDeMoi" class="form-check-input bg-transparent border-secondary" id="rememberMe" />
                        <label asp-for="SeSouvenirDeMoi" class="form-check-label text-white-50 small" for="rememberMe"></label>
                    </div>
                </div>

                <!-- Bouton de Soumission -->
                <button type="submit" class="btn btn-ecobank w-100 shadow-sm d-flex align-items-center justify-content-center gap-2">
                    <span>Se connecter</span>
                    <i class="bi bi-arrow-right-short fs-4"></i>
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top border-white border-opacity-10">
                <small class="text-white-50" style="font-size: 0.75rem;">
                    &copy; @DateTime.Now.Year Ecobank Transnational Incorporated. Tous droits réservés.
                </small>
            </div>

        </div>
    </div>

    <!-- Scripts de validation ASP.NET Core MVC -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Toggle affichage mot de passe
        document.getElementById('togglePassword').addEventListener('click', function () {
        const passwordInput = document.getElementById('passwordInput');
        const icon = document.getElementById('toggleIcon');

        if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        icon.classList.remove('bi-eye-fill');
        icon.classList.add('bi-eye-slash-fill');
        } else {
        passwordInput.type = 'password';
        icon.classList.remove('bi-eye-slash-fill');
        icon.classList.add('bi-eye-fill');
        }
        });
    </script>

</body>
</html>