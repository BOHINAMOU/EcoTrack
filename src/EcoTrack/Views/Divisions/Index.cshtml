@model IEnumerable<EcoTrack.Models.Division>
@{
    ViewData["Title"] = "Divisions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Divisions</h3>
        <p class="text-muted mb-0">@Model.Count() division(s) enregistrée(s)</p>
    </div>
    @if (User.IsInRole("AdminPrincipal"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Nouvelle division
        </a>
    }
</div>

<div class="table-responsive-wrapper">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Département</th>
                <th>Agence</th>
                <th>Services</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var division in Model)
            {
                <tr class="@(!division.EstActif ? "table-secondary" : "")">
                    <td><a asp-action="Details" asp-route-id="@division.Id">@division.Nom</a></td>
                    <td>@division.Departement?.Nom</td>
                    <td>@division.Departement?.Agence?.Nom</td>
                    <td>@division.Services.Count</td>
                    <td>
                        @if (division.EstActif)
                        {
                            <span class="badge bg-success">Actif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Désactivé</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole("AdminPrincipal"))
                        {
                            <a asp-action="Edit" asp-route-id="@division.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                            <form asp-action="BasculerActivation" asp-route-id="@division.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (division.EstActif)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Réactiver</button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aucune division enregistrée pour l'instant.</p>
}