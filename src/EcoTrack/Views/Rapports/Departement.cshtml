@{
    ViewData["Title"] = "Rapport par unité";
    var agences = ViewBag.Agences as IEnumerable<EcoTrack.Models.Agence>;
    var departements = ViewBag.Departements as IEnumerable<EcoTrack.Models.Departement>;
    var divisions = ViewBag.Divisions as IEnumerable<EcoTrack.Models.Division>;
    var services = ViewBag.Services as IEnumerable<EcoTrack.Models.Service>;
    var unites = ViewBag.Unites as IEnumerable<EcoTrack.Models.Unite>;
}

<h3>Rapport par agence, département, division, service ou unité</h3>
<p class="text-muted">Le rapport inclut les employés de l'unité choisie (et de ses sous-unités), leurs actifs attribués, et les actifs partagés rattachés directement à cette unité.</p>

<div class="card p-4" style="max-width: 500px;">
    <form asp-action="Departement" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Choisir une unité</label>
            <select name="cible" class="form-select" required>
                <option value="">-- Choisir --</option>
                <optgroup label="Agence">
                    @if (agences is not null)
                    {
                        foreach (var a in agences)
                        {
                            <option value="AG:@a.Id">@a.Nom</option>
                        }
                    }
                </optgroup>
                <optgroup label="Département">
                    @if (departements is not null)
                    {
                        foreach (var d in departements)
                        {
                            <option value="DP:@d.Id">@d.Nom</option>
                        }
                    }
                </optgroup>
                <optgroup label="Division">
                    @if (divisions is not null)
                    {
                        foreach (var d in divisions)
                        {
                            <option value="DV:@d.Id">@d.Nom</option>
                        }
                    }
                </optgroup>
                <optgroup label="Service">
                    @if (services is not null)
                    {
                        foreach (var s in services)
                        {
                            <option value="SV:@s.Id">@s.Nom</option>
                        }
                    }
                </optgroup>
                <optgroup label="Unité">
                    @if (unites is not null)
                    {
                        foreach (var u in unites)
                        {
                            <option value="UN:@u.Id">@u.Nom</option>
                        }
                    }
                </optgroup>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-file-earmark-pdf"></i> Générer le PDF
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Retour</a>
    </form>
</div>