@model EcoTrack.ViewModels.EmployeModifierViewModel
@{
    ViewData["Title"] = "Modifier l'employé";
}

<h3>Modifier : @Model.Prenom @Model.Nom</h3>
<p class="text-muted">Les actifs déjà attribués à cet employé ne seront pas affectés par cette modification.</p>

<div class="card p-4">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nom" class="form-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Prenom" class="form-label"></label>
                <input asp-for="Prenom" class="form-control" />
                <span asp-validation-for="Prenom" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Indicatif" class="form-label"></label>
                <select asp-for="Indicatif" class="form-select">
                    @foreach (var (code, pays) in Model.Indicatifs)
                    {
                        <option value="@code">@code (@pays)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="NumeroTelephone" class="form-label"></label>
                <input asp-for="NumeroTelephone" class="form-control" inputmode="numeric" pattern="[0-9]*" />
                <span asp-validation-for="NumeroTelephone" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Poste" class="form-label"></label>
                <input asp-for="Poste" class="form-control" />
                <span asp-validation-for="Poste" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="DepartementId" class="form-label"></label>
                <select asp-for="DepartementId" class="form-select"
                        asp-items="@(new SelectList(Model.Departements, "Id", "Nom"))">
                </select>
                <span asp-validation-for="DepartementId" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}