@model EcoTrack.ViewModels.EmployeModifierViewModel
@{
    ViewData["Title"] = "Modifier l'employé";
}

<h3>Modifier : @Model.Prenom @Model.Nom</h3>
<p class="text-muted">Les actifs déjà attribués à cet employé ne seront pas affectés par cette modification.</p>

<div class="card p-4">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nom" class="form-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Prenom" class="form-label"></label>
                <input asp-for="Prenom" class="form-control" />
                <span asp-validation-for="Prenom" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Indicatif" class="form-label"></label>
                <select asp-for="Indicatif" class="form-select">
                    @foreach (var (code, pays) in Model.IndicatifsListe)
                    {
                        <option value="@code">@code (@pays)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="NumeroTelephone" class="form-label"></label>
                <input asp-for="NumeroTelephone" class="form-control" inputmode="numeric" pattern="[0-9]*" />
                <span asp-validation-for="NumeroTelephone" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Poste" class="form-label"></label>
                <input asp-for="Poste" class="form-control" />
            </div>
        </div>

        <hr class="my-4" />
        <h5 class="mb-3">Positionnement organisationnel</h5>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Agence</label>
                <select id="selectAgence" class="form-select">
                    <option value="">-- Choisir --</option>
                    @foreach (var a in Model.Agences)
                    {
                        <option value="@a.Id">@a.Nom</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Département</label>
                <select id="selectDepartement" class="form-select" disabled>
                    <option value="">-- Choisir --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Division</label>
                <select id="selectDivision" class="form-select" disabled>
                    <option value="">-- Choisir --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Service</label>
                <select id="selectService" class="form-select" disabled>
                    <option value="">-- Choisir --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="UniteId" class="form-label">Unité</label>
                <select asp-for="UniteId" id="selectUnite" name="UniteId" class="form-select" disabled required>
                    <option value="">-- Choisir --</option>
                </select>
                <span asp-validation-for="UniteId" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        var tousDepartements = @Html.Raw(Json.Serialize(Model.Departements.Select(d => new { id = d.Id, nom = d.Nom, agenceId = d.AgenceId })));
        var toutesDivisions = @Html.Raw(Json.Serialize(Model.Divisions.Select(d => new { id = d.Id, nom = d.Nom, departementId = d.DepartementId })));
        var tousServices = @Html.Raw(Json.Serialize(Model.Services.Select(s => new { id = s.Id, nom = s.Nom, divisionId = s.DivisionId })));
        var toutesUnites = @Html.Raw(Json.Serialize(Model.Unites.Select(u => new { id = u.Id, nom = u.Nom, serviceId = u.ServiceId })));
        var uniteActuelleId = @Model.UniteId;

        var selAgence = document.getElementById('selectAgence');
        var selDepartement = document.getElementById('selectDepartement');
        var selDivision = document.getElementById('selectDivision');
        var selService = document.getElementById('selectService');
        var selUnite = document.getElementById('selectUnite');

        var optionsChoices = { searchEnabled: true, shouldSort: false, itemSelectText: '', searchPlaceholderValue: 'Taper pour chercher...' };
        var choicesAgence = new Choices(selAgence, optionsChoices);
        var choicesDepartement = new Choices(selDepartement, optionsChoices);
        var choicesDivision = new Choices(selDivision, optionsChoices);
        var choicesService = new Choices(selService, optionsChoices);
        var choicesUnite = new Choices(selUnite, optionsChoices);

        function remplir(instance, options, valeurASelectionner) {
            var liste = [{ value: '', label: '-- Choisir --' }];
            options.forEach(function (o) {
                liste.push({
                    value: String(o.id),
                    label: o.nom,
                    selected: valeurASelectionner != null && o.id === valeurASelectionner
                });
            });
            instance.setChoices(liste, 'value', 'label', true);
        }

        selAgence.addEventListener('change', function () {
            var liste = tousDepartements.filter(function (d) { return d.agenceId == selAgence.value; });
            remplir(choicesDepartement, liste); selAgence.value ? choicesDepartement.enable() : choicesDepartement.disable();
            remplir(choicesDivision, []); choicesDivision.disable();
            remplir(choicesService, []); choicesService.disable();
            remplir(choicesUnite, []); choicesUnite.disable();
        });
        selDepartement.addEventListener('change', function () {
            var liste = toutesDivisions.filter(function (d) { return d.departementId == selDepartement.value; });
            remplir(choicesDivision, liste); selDepartement.value ? choicesDivision.enable() : choicesDivision.disable();
            remplir(choicesService, []); choicesService.disable();
            remplir(choicesUnite, []); choicesUnite.disable();
        });
        selDivision.addEventListener('change', function () {
            var liste = tousServices.filter(function (s) { return s.divisionId == selDivision.value; });
            remplir(choicesService, liste); selDivision.value ? choicesService.enable() : choicesService.disable();
            remplir(choicesUnite, []); choicesUnite.disable();
        });
        selService.addEventListener('change', function () {
            var liste = toutesUnites.filter(function (u) { return u.serviceId == selService.value; });
            remplir(choicesUnite, liste); selService.value ? choicesUnite.enable() : choicesUnite.disable();
        });

        // --- Pré-sélection de la chaîne actuelle au chargement ---
        (function preselectionner() {
            var unite = toutesUnites.find(function (u) { return u.id === uniteActuelleId; });
            if (!unite) return;
            var service = tousServices.find(function (s) { return s.id === unite.serviceId; });
            if (!service) return;
            var division = toutesDivisions.find(function (d) { return d.id === service.divisionId; });
            if (!division) return;
            var departement = tousDepartements.find(function (d) { return d.id === division.departementId; });
            if (!departement) return;

            choicesAgence.setChoiceByValue(String(departement.agenceId));
            remplir(choicesDepartement, tousDepartements.filter(function (d) { return d.agenceId == departement.agenceId; }), departement.id);
            choicesDepartement.enable();
            remplir(choicesDivision, toutesDivisions.filter(function (d) { return d.departementId == departement.id; }), division.id);
            choicesDivision.enable();
            remplir(choicesService, tousServices.filter(function (s) { return s.divisionId == division.id; }), service.id);
            choicesService.enable();
            remplir(choicesUnite, toutesUnites.filter(function (u) { return u.serviceId == service.id; }), unite.id);
            choicesUnite.enable();
        })();
    </script>
}