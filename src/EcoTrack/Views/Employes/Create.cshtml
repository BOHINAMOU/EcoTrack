@model EcoTrack.ViewModels.EmployeCreerViewModel
@{
    ViewData["Title"] = "Nouvel employé";
}

<h3>Nouvel employé</h3>
<p class="text-muted">L'attribution d'un actif est obligatoire à la création.</p>

<div class="card p-4">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <h5 class="mb-3">Informations de l'employé</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nom" class="form-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Prenom" class="form-label"></label>
                <input asp-for="Prenom" class="form-control" />
                <span asp-validation-for="Prenom" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Indicatif" class="form-label"></label>
                <select asp-for="Indicatif" class="form-select">
                    @foreach (var (code, pays) in Model.IndicatifsListe)
                    {
                        <option value="@code">@code (@pays)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="NumeroTelephone" class="form-label"></label>
                <input asp-for="NumeroTelephone" class="form-control" inputmode="numeric" pattern="[0-9]*" />
                <span asp-validation-for="NumeroTelephone" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Poste" class="form-label"></label>
                <input asp-for="Poste" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NomUtilisateur" class="form-label"></label>
                <input asp-for="NomUtilisateur" class="form-control" placeholder="Laisser vide pour générer automatiquement" />
                <span asp-validation-for="NomUtilisateur" class="text-danger"></span>
            </div>
        </div>

        <hr class="my-4" />
        <h5 class="mb-3">Positionnement organisationnel</h5>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Agence</label>
                <select id="selectAgence" class="form-select">
                    <option value="">-- Choisir --</option>
                    @foreach (var a in Model.Agences)
                    {
                        <option value="@a.Id">@a.Nom</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Département</label>
                <select id="selectDepartement" class="form-select" disabled>
                    <option value="">-- Choisir l'agence d'abord --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Division</label>
                <select id="selectDivision" class="form-select" disabled>
                    <option value="">-- Choisir le département d'abord --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Service</label>
                <select id="selectService" class="form-select" disabled>
                    <option value="">-- Choisir la division d'abord --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="UniteId" class="form-label">Unité</label>
                <select asp-for="UniteId" id="selectUnite" name="UniteId" class="form-select" disabled required>
                    <option value="">-- Choisir le service d'abord --</option>
                </select>
                <span asp-validation-for="UniteId" class="text-danger"></span>
            </div>
        </div>

        <hr class="my-4" />
        <h5 class="mb-3">Attribution d'un actif <span class="text-danger">*</span></h5>

        <div class="mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="ModeAttribution"
                       value="@EcoTrack.ViewModels.ModeAttributionActif.ActifExistant" id="modeExistant" checked />
                <label class="form-check-label" for="modeExistant">Choisir un actif existant en stock</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="ModeAttribution"
                       value="@EcoTrack.ViewModels.ModeAttributionActif.NouvelActif" id="modeNouveau" />
                <label class="form-check-label" for="modeNouveau">Enregistrer un nouvel actif</label>
            </div>
        </div>

        <div id="blocActifExistant" class="mb-3">
            <label asp-for="ActifExistantId" class="form-label"></label>
            <select asp-for="ActifExistantId" class="form-select"
                    asp-items="@(new SelectList(Model.ActifsDisponibles, "Id", "Nom"))">
                <option value="">-- Choisir un actif disponible --</option>
            </select>
            @if (!Model.ActifsDisponibles.Any())
            {
                <div class="form-text text-warning">Aucun actif disponible en stock actuellement.</div>
            }
        </div>

        <div id="blocNouvelActif" class="row" style="display: none;">
            <div class="col-md-6 mb-3">
                <label asp-for="NouvelActifNom" class="form-label"></label>
                <input asp-for="NouvelActifNom" class="form-control" />
                <span asp-validation-for="NouvelActifNom" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NouvelActifNumeroSerie" class="form-label"></label>
                <input asp-for="NouvelActifNumeroSerie" class="form-control" />
                <span asp-validation-for="NouvelActifNumeroSerie" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NouvelActifMarque" class="form-label"></label>
                <input asp-for="NouvelActifMarque" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NouvelActifModele" class="form-label"></label>
                <input asp-for="NouvelActifModele" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NouvelActifCategorieId" class="form-label"></label>
                <select asp-for="NouvelActifCategorieId" class="form-select"
                        asp-items="@(new SelectList(Model.Categories, "Id", "Nom"))">
                    <option value="">-- Choisir --</option>
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Créer l'employé</button>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">Annuler</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // --- Bascule actif existant / nouvel actif ---
        var radioExistant = document.getElementById('modeExistant');
        var radioNouveau = document.getElementById('modeNouveau');
        var blocExistant = document.getElementById('blocActifExistant');
        var blocNouveau = document.getElementById('blocNouvelActif');

        function basculerAffichage() {
            var estExistant = radioExistant.checked;
            blocExistant.style.display = estExistant ? '' : 'none';
            blocNouveau.style.display = estExistant ? 'none' : '';
        }
        radioExistant.addEventListener('change', basculerAffichage);
        radioNouveau.addEventListener('change', basculerAffichage);
        basculerAffichage();

        // --- Cascade organisationnelle à 5 niveaux, avec recherche au clavier (Choices.js) ---
        var tousDepartements = @Html.Raw(Json.Serialize(Model.Departements.Select(d => new { id = d.Id, nom = d.Nom, agenceId = d.AgenceId })));
        var toutesDivisions = @Html.Raw(Json.Serialize(Model.Divisions.Select(d => new { id = d.Id, nom = d.Nom, departementId = d.DepartementId })));
        var tousServices = @Html.Raw(Json.Serialize(Model.Services.Select(s => new { id = s.Id, nom = s.Nom, divisionId = s.DivisionId })));
        var toutesUnites = @Html.Raw(Json.Serialize(Model.Unites.Select(u => new { id = u.Id, nom = u.Nom, serviceId = u.ServiceId })));

        var selAgence = document.getElementById('selectAgence');
        var selDepartement = document.getElementById('selectDepartement');
        var selDivision = document.getElementById('selectDivision');
        var selService = document.getElementById('selectService');
        var selUnite = document.getElementById('selectUnite');

        var optionsChoices = { searchEnabled: true, shouldSort: false, itemSelectText: '', searchPlaceholderValue: 'Taper pour chercher...' };
        var choicesAgence = new Choices(selAgence, optionsChoices);
        var choicesDepartement = new Choices(selDepartement, optionsChoices);
        var choicesDivision = new Choices(selDivision, optionsChoices);
        var choicesService = new Choices(selService, optionsChoices);
        var choicesUnite = new Choices(selUnite, optionsChoices);

        function remplir(instance, options, texteVide) {
            var liste = [{ value: '', label: texteVide }];
            options.forEach(function (o) {
                liste.push({ value: String(o.id), label: o.nom });
            });
            instance.setChoices(liste, 'value', 'label', true);
        }

        selAgence.addEventListener('change', function () {
            var liste = tousDepartements.filter(function (d) { return d.agenceId == selAgence.value; });
            remplir(choicesDepartement, liste, '-- Choisir --');
            selAgence.value ? choicesDepartement.enable() : choicesDepartement.disable();
            remplir(choicesDivision, [], '-- Choisir le département d\'abord --'); choicesDivision.disable();
            remplir(choicesService, [], '-- Choisir la division d\'abord --'); choicesService.disable();
            remplir(choicesUnite, [], '-- Choisir le service d\'abord --'); choicesUnite.disable();
        });

        selDepartement.addEventListener('change', function () {
            var liste = toutesDivisions.filter(function (d) { return d.departementId == selDepartement.value; });
            remplir(choicesDivision, liste, '-- Choisir --');
            selDepartement.value ? choicesDivision.enable() : choicesDivision.disable();
            remplir(choicesService, [], '-- Choisir la division d\'abord --'); choicesService.disable();
            remplir(choicesUnite, [], '-- Choisir le service d\'abord --'); choicesUnite.disable();
        });

        selDivision.addEventListener('change', function () {
            var liste = tousServices.filter(function (s) { return s.divisionId == selDivision.value; });
            remplir(choicesService, liste, '-- Choisir --');
            selDivision.value ? choicesService.enable() : choicesService.disable();
            remplir(choicesUnite, [], '-- Choisir le service d\'abord --'); choicesUnite.disable();
        });

        selService.addEventListener('change', function () {
            var liste = toutesUnites.filter(function (u) { return u.serviceId == selService.value; });
            remplir(choicesUnite, liste, '-- Choisir --');
            selService.value ? choicesUnite.enable() : choicesUnite.disable();
        });
    </script>
}