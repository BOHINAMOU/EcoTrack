@model EcoTrack.ViewModels.EmployeDetailsViewModel
@{
    ViewData["Title"] = "Fiche employé";
    var employe = Model.Employe;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">@employe.Prenom @employe.Nom</h3>
        <p class="text-muted mb-0">
            @(employe.Poste ?? "Poste non renseigné") — @employe.Departement?.Nom / @employe.Service?.Nom
            @if (!employe.EstActif)
            {
                <span class="badge bg-secondary ms-2">Inactif</span>
            }
        </p>
    </div>
    <div>
        @if (User.IsInRole("AdminPrincipal"))
        {
            <a asp-action="Edit" asp-route-id="@employe.Id" class="btn btn-outline-primary">Modifier les infos</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Retour</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="stat-card">
            <h6 class="mb-3">Coordonnées</h6>
            <p class="mb-1"><i class="bi bi-envelope me-2"></i>@employe.Email</p>
            <p class="mb-0"><i class="bi bi-telephone me-2"></i>@(employe.Telephone ?? "—")</p>
        </div>
    </div>

    <div class="col-md-8">
        <div class="stat-card">
            <h6 class="mb-3">Actifs actuellement attribués (@Model.AffectationsActives.Count)</h6>

            @if (Model.AffectationsActives.Any())
            {
                <div class="table-responsive-wrapper">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Actif</th>
                                <th>Catégorie</th>
                                <th>Depuis le</th>
                                <th>Réattribution</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ligne in Model.AffectationsActives)
                            {
                                var affectation = ligne.Affectation;
                                <tr>
                                    <td>@affectation.Actif?.Nom (@affectation.Actif?.NumeroSerie)</td>
                                    <td>@affectation.Actif?.CategorieActif?.Nom</td>
                                    <td>@affectation.DateAffectation.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (ligne.EstReattribution)
                                        {
                                            <span class="badge bg-warning text-dark">Oui</span>
                                            <div class="small text-muted">Précédemment : @ligne.DetenteurPrecedentNom</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Non</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="RetirerActif" method="post" class="d-inline formulaire-retrait">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="affectationId" value="@affectation.Id" />
                                            <input type="hidden" name="employeId" value="@employe.Id" />
                                            <input type="hidden" name="motif" class="champ-motif-retrait" />
                                            <button type="button" class="btn btn-sm btn-outline-danger bouton-demander-motif">Retirer</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Aucun actif attribué actuellement.</p>
            }
        </div>
    </div>
</div>

<div class="stat-card mt-4">
    <h6 class="mb-3">Historique des actifs précédemment détenus</h6>
    @if (Model.HistoriqueComplet.Any())
    {
        <div class="table-responsive-wrapper">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Actif</th>
                        <th>Numéro de série</th>
                        <th>Attribué le</th>
                        <th>Retiré le</th>
                        <th>Motif</th>
                        <th>Réattribution</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ligne in Model.HistoriqueComplet)
                    {
                        var affectation = ligne.Affectation;
                        <tr>
                            <td>
                                <a asp-controller="Actifs" asp-action="Details" asp-route-id="@affectation.ActifId">
                                    @affectation.Actif?.Nom
                                </a>
                            </td>
                            <td>@affectation.Actif?.NumeroSerie</td>
                            <td>@affectation.DateAffectation.ToString("dd/MM/yyyy")</td>
                            <td>@affectation.DateRetrait?.ToString("dd/MM/yyyy")</td>
                            <td>@(affectation.Motif ?? "—")</td>
                            <td>
                                @if (ligne.EstReattribution)
                                {
                                    <span class="badge bg-warning text-dark">Oui</span>
                                    @if (ligne.MemeEmployeQuAvant)
                                    {
                                        <div class="small text-muted">Même employé qu'avant</div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">Avant : @ligne.DetenteurPrecedentNom</div>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Non</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">Aucun actif retiré dans le passé pour cet employé.</p>
    }
</div>

<div class="stat-card mt-4">
    <h6 class="mb-3">Attribuer un nouvel actif</h6>
    @if (!employe.EstActif)
    {
        <p class="text-muted mb-0">
            <i class="bi bi-exclamation-triangle text-warning"></i>
            Cet employé est désactivé. Réactivez-le pour pouvoir lui attribuer un actif.
        </p>
    }
    else if (Model.ActifsDisponibles.Any())
    {
        <form asp-action="AttribuerActif" method="post"
              onsubmit="this.querySelector('button[type=submit]').disabled = true; return true;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="employeId" value="@employe.Id" />
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small">Actif</label>
                    <select name="actifId" class="form-select" required>
                        <option value="">-- Choisir un actif disponible --</option>
                        @foreach (var actif in Model.ActifsDisponibles)
                        {
                            <option value="@actif.Id">@actif.Nom (@actif.NumeroSerie)</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small">Motif (optionnel)</label>
                    <input type="text" name="motif" class="form-control" placeholder="Ex: remplacement matériel défectueux" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Attribuer</button>
                </div>
            </div>
        </form>
    }
    else
    {
        <p class="text-muted mb-0">Aucun actif disponible en stock actuellement.</p>
    }
</div>

@section Scripts {
<script>
    document.querySelectorAll('.bouton-demander-motif').forEach(function (bouton) {
        bouton.addEventListener('click', function () {
            var motif = prompt("Motif du retrait (ex: départ de l'employé, changement de poste, matériel défectueux...) :");

            if (motif === null) {
                return;
            }

            var formulaire = bouton.closest('.formulaire-retrait');
            formulaire.querySelector('.champ-motif-retrait').value = motif.trim();
            formulaire.submit();
        });
    });
</script>
}