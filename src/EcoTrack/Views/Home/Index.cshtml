@model EcoTrack.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tableau de bord";
    var initiales = $"{Model.PrenomUtilisateur.FirstOrDefault()}{Model.NomUtilisateur.FirstOrDefault()}".ToUpper();
    var totalActifs = Model.NombreActifsDisponibles + Model.NombreActifsAttribues + Model.NombreActifsDeteriores + Model.NombreActifsEnPanne;
}

<style>
 



    .dashboard-hero-banner {
        position: relative;
        padding: 35px;
        min-height: 300px;
        background-image: url('/images/logo_ecobank.avif');

        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        overflow: hidden;
        margin: -1.5rem -2rem 2rem -2rem;
        width: calc(100% + 4rem);
        border-radius: 0;
    }
        /* Voile au-dessus du background */
        .dashboard-hero-banner::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 30, 60, 0.80);
            z-index: 0;
        }

        /* Tout le contenu reste au-dessus du background */
        .dashboard-hero-banner > * {
            position: relative;
            z-index: 1;
        }

    /* Barre de recherche */
    .dashboard-hero .search-container-glass {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 12px;
    }

    /* Champ de recherche */
    .dashboard-hero .form-control {
        background: rgba(255, 255, 255, 0.95);
        border: none;
        border-radius: 8px;
    }

        /* Focus du champ */
        .dashboard-hero .form-control:focus {
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.25);
        }
</style>

<div class="dashboard-hero-banner">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="hero-avatar">@initiales</div>
            <div>
                <h2 class="fw-bold mb-1">Bienvenue, @Model.PrenomUtilisateur @Model.NomUtilisateur</h2>
                <p class="mb-0 text-white-50 small">Gestion du parc informatique & des équipements — <strong>Ecobank Togo</strong></p>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <div class="position-relative search-container-glass">
            <div class="d-flex align-items-center px-3">
                <i class="bi bi-search text-white-50 fs-5 me-2"></i>
                <input type="text" id="rechercheGlobale" class="form-control" placeholder="Rechercher un employé, un ordinateur, un numéro de série..." autocomplete="off" />
            </div>
            <div id="resultatsRecherche" class="search-results-dropdown" style="display:none;"></div>
        </div>
    </div>
</div>

<div class="pt-5">
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-3">
            <div class="card card-kpi p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Employés enregistrés</span>
                        <h2 class="fw-bold m-0 mt-1 text-dark">@Model.NombreEmployes</h2>
                    </div>
                    <div class="kpi-icon-box" style="background: rgba(0, 75, 135, 0.1); color: #004B87;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="card card-kpi p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Actifs disponibles</span>
                        <h2 class="fw-bold m-0 mt-1 text-success">@Model.NombreActifsDisponibles</h2>
                    </div>
                    <div class="kpi-icon-box" style="background: rgba(46, 133, 64, 0.1); color: #2e8540;">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="card card-kpi p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Actifs attribués</span>
                        <h2 class="fw-bold m-0 mt-1" style="color: #004B87;">@Model.NombreActifsAttribues</h2>
                    </div>
                    <div class="kpi-icon-box" style="background: rgba(0, 163, 224, 0.1); color: #00A3E0;">
                        <i class="bi bi-laptop-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="card card-kpi p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Actifs en panne</span>
                        <h2 class="fw-bold m-0 mt-1 text-dark">@Model.NombreActifsEnPanne</h2>
                    </div>
                    <div class="kpi-icon-box" style="background: rgba(33, 37, 41, 0.1); color: #212529;">
                        <i class="bi bi-tools"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card card-kpi p-3">
                <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-diagram-3 me-2"></i>Organisation</h6>
                <div class="row text-center g-3">
                    <div class="col-4 col-md-2">
                        <div class="fw-bold fs-4" style="color:#004B87;">@Model.NombreAgences</div>
                        <div class="text-muted small">Agences</div>
                    </div>
                    <div class="col-4 col-md-2">
                        <div class="fw-bold fs-4" style="color:#004B87;">@Model.NombreDepartements</div>
                        <div class="text-muted small">Départements</div>
                    </div>
                    <div class="col-4 col-md-2">
                        <div class="fw-bold fs-4" style="color:#004B87;">@Model.NombreServices</div>
                        <div class="text-muted small">Services</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="card card-kpi p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold m-0 text-dark">Répartition globale du parc</h6>
                    <span class="badge bg-light text-dark border">Total : @totalActifs actifs</span>
                </div>

                @if (totalActifs > 0)
                {
                    <canvas id="graphiqueEtatsActifs" style="max-height: 240px;"></canvas>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        Aucun actif n'est enregistré pour le moment.
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card card-kpi p-4 h-100">
                <h6 class="fw-bold mb-3 text-dark">Actions rapides</h6>
                <div class="d-flex flex-column gap-3">
                    <a asp-controller="Employes" asp-action="Create" class="btn p-3 text-start border-0 shadow-sm d-flex align-items-center gap-3" style="background: #f8fafd; border-radius: 10px;">
                        <div class="p-2 rounded-circle bg-primary text-white"><i class="bi bi-person-plus-fill"></i></div>
                        <div>
                            <div class="fw-bold text-dark">Ajouter un employé</div>
                            <small class="text-muted">Enregistrer un nouveau collaborateur</small>
                        </div>
                    </a>
                    <a asp-controller="Actifs" asp-action="Create" class="btn p-3 text-start border-0 shadow-sm d-flex align-items-center gap-3" style="background: #f8fafd; border-radius: 10px;">
                        <div class="p-2 rounded-circle text-white" style="background: #004B87;"><i class="bi bi-plus-circle-fill"></i></div>
                        <div>
                            <div class="fw-bold text-dark">Nouvel actif IT</div>
                            <small class="text-muted">Ajouter un ordinateur, écran, etc.</small>
                        </div>
                    </a>
                    <a asp-controller="Agences" asp-action="Index" class="btn p-3 text-start border-0 shadow-sm d-flex align-items-center gap-3" style="background: #f8fafd; border-radius: 10px;">
                        <div class="p-2 rounded-circle bg-secondary text-white"><i class="bi bi-building"></i></div>
                        <div>
                            <div class="fw-bold text-dark">Gestion des agences</div>
                            <small class="text-muted">Voir les sites et départements</small>
                        </div>
                    </a>
                    @if (User.IsInRole("AdminPrincipal"))
                    {
                        <a asp-controller="Utilisateurs" asp-action="TousLesUtilisateurs" class="btn p-3 text-start border-0 shadow-sm d-flex align-items-center gap-3" style="background: #f8fafd; border-radius: 10px;">
                            <div class="p-2 rounded-circle text-white" style="background: #6c757d;"><i class="bi bi-person-lock"></i></div>
                            <div>
                                <div class="fw-bold text-dark">Comptes &amp; mots de passe</div>
                                <small class="text-muted">Modifier un profil, réinitialiser un mot de passe</small>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        var ctxEtats = document.getElementById('graphiqueEtatsActifs');
        if (ctxEtats) {
        new Chart(ctxEtats, {
        type: 'bar',
        data: {
        labels: ['Disponibles', 'Attribués', 'Détériorés', 'En panne'],
        datasets: [{
        data: [@Model.NombreActifsDisponibles, @Model.NombreActifsAttribues, @Model.NombreActifsDeteriores, @Model.NombreActifsEnPanne],
        backgroundColor: ['#2e8540', '#004B87', '#d9534f', '#212529'],
        borderRadius: 6,
        barThickness: 30
        }]
        },
        options: {
        indexAxis: 'y',
        plugins: {
        legend: { display: false },
        tooltip: {
        callbacks: {
        label: function (contexte) {
        var total = contexte.dataset.data.reduce(function (a, b) { return a + b; }, 0);
        var valeur = contexte.parsed.x;
        var pct = total > 0 ? Math.round((valeur / total) * 1000) / 10 : 0;
        return valeur + ' actif(s) — ' + pct + '%';
        }
        }
        }
        },
        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
        }
        });
        }

        var champRecherche = document.getElementById('rechercheGlobale');
        var zoneResultats = document.getElementById('resultatsRecherche');
        var minuteur;

        champRecherche.addEventListener('input', function () {
        clearTimeout(minuteur);
        var terme = champRecherche.value.trim();
        if (terme.length < 2) { zoneResultats.style.display = 'none'; return; }

        minuteur = setTimeout(function () {
        fetch('/Home/Rechercher?terme=' + encodeURIComponent(terme))
        .then(function (r) { return r.json(); })
        .then(function (d) { afficherResultats(d); });
        }, 300);
        });

        function afficherResultats(donnees) {
        var html = '';
        if (donnees.employes && donnees.employes.length > 0) {
        html += '<div class="search-section-title">Employés</div>';
        donnees.employes.forEach(function (e) {
        html += '<a class="search-item" href="/Employes/Details/' + e.id + '"><strong>' + e.nomComplet + '</strong> <small class="text-muted">(' + e.departement + ')</small></a>';
        });
        }
        if (donnees.actifs && donnees.actifs.length > 0) {
        html += '<div class="search-section-title">Actifs</div>';
        donnees.actifs.forEach(function (a) {
        var detenteur = a.employeActuel ? ('Chez ' + a.employeActuel) : 'Non attribué';
        var lien = a.employeId ? ('/Employes/Details/' + a.employeId) : '#';
        html += '<a class="search-item" href="' + lien + '"><strong>' + a.nom + '</strong> <small>(' + a.numeroSerie + ')</small> — <span class="badge bg-secondary">' + a.etat + '</span><br><small class="text-muted">' + detenteur + '</small></a>';
        });
        }
        if (html === '') { html = '<div class="p-3 text-muted small text-center">Aucun résultat trouvé.</div>'; }
        zoneResultats.innerHTML = html;
        zoneResultats.style.display = 'block';
        }

        document.addEventListener('click', function (e) {
        if (!champRecherche.contains(e.target) && !zoneResultats.contains(e.target)) {
        zoneResultats.style.display = 'none';
        }
        });
    </script>
}