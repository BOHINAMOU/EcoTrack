@using EcoTrack.Models
@{
    ViewData["Title"] = "Mon espace";
    var employe = (Employe)ViewBag.Employe;
    var mesActifs = (List<Actif>)ViewBag.MesActifs;
    var actifsAgence = (List<Actif>)ViewBag.ActifsAgence;
    var initiales = $"{employe.Prenom.FirstOrDefault()}{employe.Nom.FirstOrDefault()}".ToString().ToUpper();
}
