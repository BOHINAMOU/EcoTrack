@model IEnumerable<EcoTrack.Models.CategorieActif>
@{
    ViewData["Title"] = "Catégories d'actifs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Catégories d'actifs</h3>
        <p class="text-muted mb-0">@Model.Count() catégorie(s) enregistrée(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nouvelle catégorie
    </a>
</div>

<div class="table-responsive-wrapper">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Nombre d'actifs</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categorie in Model)
            {
                <tr class="@(!categorie.EstActif ? "table-secondary" : "")">
                    <td>@categorie.Nom</td>
                    <td>@(categorie.Description ?? "—")</td>
                    <td>@categorie.Actifs.Count</td>
                    <td>
                        @if (categorie.EstActif)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Désactivée</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@categorie.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                        <form asp-action="BasculerActivation" asp-route-id="@categorie.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (categorie.EstActif)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Réactiver</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aucune catégorie enregistrée pour l'instant.</p>
}