@model EcoTrack.Models.Actif
@{
    ViewData["Title"] = "Détails de l'actif";
    var historique = ViewBag.Historique as List<EcoTrack.ViewModels.HistoriqueLigneViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">@Model.Nom</h3>
        <p class="text-muted mb-0">N° série : @Model.NumeroSerie | Catégorie : @Model.CategorieActif?.Nom</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Modifier</a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>
</div>

<div class="stat-card mb-4" style="max-width: 350px;">
    <div class="stat-label">État actuel</div>
    <div class="stat-value mb-3">
        @switch (Model.Etat)
        {
            case EcoTrack.Enums.EtatActif.Disponible:
                <span class="badge bg-success fs-6">Disponible</span>
                break;
            case EcoTrack.Enums.EtatActif.Attribue:
                <span class="badge fs-6" style="background-color: var(--ecotrack-bleu);">Attribué</span>
                break;
            case EcoTrack.Enums.EtatActif.Deteriore:
                <span class="badge bg-danger fs-6">Détérioré</span>
                break;
        }
    </div>

    @if (User.IsInRole("AdminPrincipal"))
    {
        @if (Model.Etat == EcoTrack.Enums.EtatActif.Disponible)
        {
            <form asp-action="MarquerDeteriore" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Marquer cet actif comme détérioré ?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger">Marquer comme détérioré</button>
            </form>
        }
        @if (Model.Etat == EcoTrack.Enums.EtatActif.Deteriore)
        {
            <form asp-action="Reactiver" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-success">Remettre disponible</button>
            </form>
        }
        @if (Model.Etat == EcoTrack.Enums.EtatActif.Attribue)
        {
            <p class="text-muted small mb-0">Impossible de le marquer détérioré tant qu'il est attribué. Retirez-le d'abord depuis la fiche de l'employé.</p>
        }
    }
</div>

<h5 class="mb-3">Historique complet des affectations</h5>
<div class="table-responsive-wrapper">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Employé</th>
                <th>Du</th>
                <th>Au</th>
                <th>Motif</th>
                <th>Réattribution</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ligne in historique)
            {
                var affectation = ligne.Affectation;
                <tr>
                    <td>
                        <a asp-controller="Employes" asp-action="Details" asp-route-id="@affectation.EmployeId">
                            @affectation.Employe?.Prenom @affectation.Employe?.Nom
                        </a>
                    </td>
                    <td>@affectation.DateAffectation.ToString("dd/MM/yyyy")</td>
                    <td>@(affectation.DateRetrait?.ToString("dd/MM/yyyy") ?? "En cours")</td>
                    <td>@(affectation.Motif ?? "—")</td>
                    <td>
                        @if (ligne.EstReattribution)
                        {
                            <span class="badge bg-warning text-dark">Oui</span>
                            @if (ligne.MemeEmployeQuAvant)
                            {
                                <div class="small text-muted">Même employé qu'avant</div>
                            }
                            else
                            {
                                <div class="small text-muted">Avant : @ligne.DetenteurPrecedentNom</div>
                            }
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border">Non</span>
                        }
                    </td>
                </tr>
            }
            @if (!historique.Any())
            {
                <tr>
                    <td colspan="5" class="text-muted">Cet actif n'a jamais été attribué.</td>
                </tr>
            }
        </tbody>
    </table>
</div>