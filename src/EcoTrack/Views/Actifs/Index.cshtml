@model IEnumerable<EcoTrack.Models.Actif>
@{
    ViewData["Title"] = "Actifs";
    string? filtre = ViewBag.FiltreActuel;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Gestion des actifs</h3>
        <p class="text-muted mb-0">@Model.Count() actif(s) affiché(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nouvel actif
    </a>
</div>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm @(filtre == null ? "btn-primary" : "btn-outline-secondary")">Tous</a>
    <a asp-action="Index" asp-route-etat="Disponible" class="btn btn-sm @(filtre == "Disponible" ? "btn-primary" : "btn-outline-secondary")">Disponibles</a>
    <a asp-action="Index" asp-route-etat="Attribue" class="btn btn-sm @(filtre == "Attribue" ? "btn-primary" : "btn-outline-secondary")">Attribués</a>
    <a asp-action="Index" asp-route-etat="Deteriore" class="btn btn-sm @(filtre == "Deteriore" ? "btn-primary" : "btn-outline-secondary")">Détériorés</a>
</div>

<div class="table-responsive-wrapper">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Numéro de série</th>
                <th>Catégorie</th>
                <th>État</th>
                <th>Détenteur actuel</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var actif in Model)
            {
                var affectationActive = actif.Affectations.FirstOrDefault(a => a.DateRetrait == null);
                <tr>
                    <td><a asp-action="Details" asp-route-id="@actif.Id">@actif.Nom</a></td>
                    <td>@actif.NumeroSerie</td>
                    <td>@actif.CategorieActif?.Nom</td>
                    <td>
                        @switch (actif.Etat)
                        {
                            case EcoTrack.Enums.EtatActif.Disponible:
                                <span class="badge bg-success">Disponible</span>
                                break;
                            case EcoTrack.Enums.EtatActif.Attribue:
                                <span class="badge" style="background-color: var(--ecotrack-bleu);">Attribué</span>
                                break;
                            case EcoTrack.Enums.EtatActif.Deteriore:
                                <span class="badge bg-danger">Détérioré</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (affectationActive is not null)
                        {
                            <a asp-controller="Employes" asp-action="Details" asp-route-id="@affectationActive.EmployeId">
                                @affectationActive.Employe?.Prenom @affectationActive.Employe?.Nom
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@actif.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                        @if (User.IsInRole("AdminPrincipal"))
                        {
                            @if (actif.Etat == EcoTrack.Enums.EtatActif.Disponible)
                            {
                                <form asp-action="MarquerDeteriore" asp-route-id="@actif.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Marquer cet actif comme détérioré ?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Détériorer</button>
                                </form>
                            }
                            @if (actif.Etat == EcoTrack.Enums.EtatActif.Deteriore)
                            {
                                <form asp-action="Reactiver" asp-route-id="@actif.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">Réactiver</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aucun actif à afficher.</p>
}