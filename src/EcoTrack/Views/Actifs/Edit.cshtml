@model EcoTrack.ViewModels.ActifFormViewModel
@{
    ViewData["Title"] = "Modifier l'actif";
}

<h3>Modifier : @Model.Nom</h3>

<div class="card p-4" style="max-width: 600px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nom" class="form-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NumeroSerie" class="form-label"></label>
                <input asp-for="NumeroSerie" class="form-control" />
                <span asp-validation-for="NumeroSerie" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Marque" class="form-label"></label>
                <input asp-for="Marque" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Modele" class="form-label"></label>
                <input asp-for="Modele" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="DateAcquisition" class="form-label"></label>
                <input asp-for="DateAcquisition" class="form-control" />
                <span asp-validation-for="DateAcquisition" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CategorieActifId" class="form-label"></label>
                <select asp-for="CategorieActifId" class="form-select"
                        asp-items="@(new SelectList(Model.Categories, "Id", "Nom"))">
                </select>
                <span asp-validation-for="CategorieActifId" class="text-danger"></span>
            </div>
            <div class="col-md-12 mb-3">
                <label asp-for="ProprietaireUnite" class="form-label"></label>
                <select asp-for="ProprietaireUnite" class="form-select">
                    <option value="">-- Aucun (actif disponible) --</option>
                    <optgroup label="Employé">
                        @foreach (var e in Model.Employes)
                        {
                            <option value="EM:@e.Id">@e.Prenom @e.Nom</option>
                        }
                    </optgroup>
                    <optgroup label="Agence">
                        @foreach (var a in Model.Agences)
                        {
                            <option value="AG:@a.Id">@a.Nom</option>
                        }
                    </optgroup>
                    <optgroup label="Département">
                        @foreach (var d in Model.Departements)
                        {
                            <option value="DP:@d.Id">@d.Nom</option>
                        }
                    </optgroup>
                    <optgroup label="Division">
                        @foreach (var d in Model.Divisions)
                        {
                            <option value="DV:@d.Id">@d.Nom</option>
                        }
                    </optgroup>
                    <optgroup label="Service">
                        @foreach (var s in Model.Services)
                        {
                            <option value="SV:@s.Id">@s.Nom</option>
                        }
                    </optgroup>
                    <optgroup label="Unité">
                        @foreach (var u in Model.Unites)
                        {
                            <option value="UN:@u.Id">@u.Nom</option>
                        }
                    </optgroup>
                </select>
                <div class="form-text">À un employé précis, ou à toute une unité si l'actif est partagé. Sans effet si l'actif est en panne ou détérioré.</div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}