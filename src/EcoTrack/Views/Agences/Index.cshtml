@model IEnumerable<EcoTrack.Models.Agence>
@{
    ViewData["Title"] = "Agences";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Agences / Sites</h3>
        <p class="text-muted mb-0">@Model.Count() agence(s) enregistrée(s)</p>
    </div>
    @if (User.IsInRole("AdminPrincipal"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Nouvelle agence
        </a>
    }
</div>

<div class="table-responsive-wrapper">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Code</th>
                <th>Localisation</th>
                <th>Départements</th>
                <th>Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var agence in Model)
            {
                <tr class="@(!agence.EstActif ? "table-secondary" : "")">
                    <td><a asp-action="Details" asp-route-id="@agence.Id">@agence.Nom</a></td>
                    <td>@agence.Code</td>
                    <td>@agence.Localisation</td>
                    <td>@agence.Departements.Count</td>
                    <td>
                        @if (agence.EstActif)
                        {
                            <span class="badge bg-success">Actif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Désactivé</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole("AdminPrincipal"))
                        {
                            <a asp-action="Edit" asp-route-id="@agence.Id" class="btn btn-sm btn-outline-primary">Renommer</a>
                            <form asp-action="BasculerActivation" asp-route-id="@agence.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (agence.EstActif)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Réactiver</button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Aucune agence enregistrée pour l'instant.</p>
}