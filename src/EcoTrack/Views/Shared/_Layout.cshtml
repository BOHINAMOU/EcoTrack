<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoTrack</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity is not null && User.Identity.IsAuthenticated)
    {
        <div class="ecotrack-layout">
            <div class="sidebar-overlay" id="sidebarOverlay"></div>

            <aside class="ecotrack-sidebar" id="ecotrackSidebar">
                <div class="sidebar-header">
                    <img src="~/images/logo-ecotrack.png" alt="EcoTrack" class="sidebar-logo" onerror="this.style.display='none'" />
                    <h5>Bienvenue sur<br /><strong>ECOTRACK</strong></h5>
                </div>

                <nav class="sidebar-nav">
                    <a asp-controller="Home" asp-action="Index" class="nav-link lien-accueil">
                        <i class="bi bi-speedometer2"></i> Mon tableau de bord
                    </a>

                    <div class="nav-link nav-group-toggle" data-cible="sousMenuEmployes">
                        <span><i class="bi bi-people"></i> Gestion employés</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div class="nav-submenu" id="sousMenuEmployes">
                        <a asp-controller="Employes" asp-action="Index">Liste des employés</a>
                        <a asp-controller="Employes" asp-action="Create">Nouvel employé</a>
                        <a asp-controller="Employes" asp-action="Rechercher">Rechercher un employé</a>
                    </div>

                    <div class="nav-link nav-group-toggle" data-cible="sousMenuActifs">
                        <span><i class="bi bi-laptop"></i> Gestion actifs</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div class="nav-submenu" id="sousMenuActifs">
                        <a asp-controller="Actifs" asp-action="Index">Tous les actifs</a>
                        <a asp-controller="Actifs" asp-action="Create">Nouvel actif</a>
                        <a asp-controller="Actifs" asp-action="Index" asp-route-etat="Disponible">Actifs disponibles</a>
                        <a asp-controller="Actifs" asp-action="Index" asp-route-etat="Attribue">Actifs attribués</a>
                    </div>

                    <a asp-controller="Departements" asp-action="Index" class="nav-link">
                        <i class="bi bi-building"></i> Agences
                    </a>
                     <div class="nav-link nav-group-toggle" data-cible="sousMenuOrganisation">
                        <span><i class="bi bi-diagram-3"></i> Catégories & Services</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div class="nav-submenu" id="sousMenuOrganisation">
                        <a asp-controller="CategoriesActifs" asp-action="Index">Catégories d'actifs</a>
                        <a asp-controller="Services" asp-action="Index">Services</a>
                    </div>
                    <a asp-controller="Rapports" asp-action="Index" class="nav-link">
                        <i class="bi bi-file-earmark-pdf"></i> Rapports
                    </a>

                    @if (User.IsInRole("AdminPrincipal"))
                    {
                        <div class="nav-link nav-group-toggle" data-cible="sousMenuUtilisateurs">
                            <span><i class="bi bi-person-gear"></i> Gestion des utilisateurs</span>
                            <i class="bi bi-chevron-down"></i>
                        </div>
                        <div class="nav-submenu" id="sousMenuUtilisateurs">
                            <a asp-controller="Utilisateurs" asp-action="Index">Voir tous les utilisateurs</a>
                            <a asp-controller="Utilisateurs" asp-action="Create">Nouvel admin secondaire</a>
                            <a asp-controller="Utilisateurs" asp-action="Actions">Actions des utilisateurs</a>
                        </div>
                    }
                </nav>

                <div class="sidebar-footer">
                    <a asp-controller="Compte" asp-action="Profil" class="btn btn-outline-light btn-sm w-100 mb-2">
                        <i class="bi bi-person-circle"></i> Mon profil
                    </a>
                    <form asp-controller="Compte" asp-action="Deconnexion" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">
                            <i class="bi bi-box-arrow-right"></i> Déconnexion
                        </button>
                    </form>
                </div>
            </aside>

            <main class="ecotrack-content">
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>

                @if (TempData["Succes"] is not null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Succes"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Erreur"] is not null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Erreur"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="container">
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById('ecotrackSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggle = document.getElementById('sidebarToggle');

        function fermerSidebar() {
            sidebar?.classList.remove('ouverte');
            overlay?.classList.remove('ouverte');
        }

        toggle?.addEventListener('click', () => {
            sidebar?.classList.toggle('ouverte');
            overlay?.classList.toggle('ouverte');
        });

        overlay?.addEventListener('click', fermerSidebar);
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.querySelectorAll('.nav-group-toggle').forEach(bouton => {
            bouton.addEventListener('click', () => {
                const cible = document.getElementById(bouton.dataset.cible);
                bouton.classList.toggle('ouvert');
                cible?.classList.toggle('ouvert');
            });
        });
    </script>
</body>
</html>