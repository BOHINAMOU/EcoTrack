<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoTrack | Ecobank Togo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            .ecotrack-sidebar {
                display: flex !important;
                flex-direction: column !important;
                height: 100vh;
            }

            .sidebar-nav {
                display: flex;
                flex-direction: column;
                flex-grow: 1;
                padding-bottom: 15px;
            }

                .sidebar-nav .nav-link, .sidebar-nav .nav-group-toggle {
                    margin-bottom: 4px;
                }
           
            .ecotrack-sidebar {
                overflow-y: auto !important;
                max-height: 100vh !important;
            }

            .nav-submenu {
                max-height: none !important;
                overflow: visible !important;
                display: none !important;
            }

                .nav-submenu.ouvert {
                    display: block !important;
                }

            .group-parametres-container {
                margin-top: auto;
                border-top: 1px solid rgba(255, 255, 255, 0.15);
                padding-top: 12px;
            }

            .submenu-parametres {
                background-color: rgba(0, 0, 0, 0.25);
                border-radius: 8px;
                margin: 4px 8px 0 8px;
                padding: 6px 0;
            }

                .submenu-parametres a, .submenu-parametres .btn-deconnexion-link {
                    display: flex;
                    align-items: center;
                    padding: 8px 16px;
                    font-size: 0.875rem;
                    text-decoration: none;
                    transition: all 0.2s ease;
                }

            .lien-profil {
                color: #e2e8f0 !important;
            }

                .lien-profil:hover {
                    color: #ffffff !important;
                    background-color: rgba(255, 255, 255, 0.1);
                }

            .btn-deconnexion-link {
                color: #fca5a5 !important;
                background: transparent;
                border: none;
                width: 100%;
                text-align: left;
            }

                .btn-deconnexion-link:hover {
                    color: #ef4444 !important;
                    background-color: rgba(239, 68, 68, 0.15);
                }

    </style>
</head>
<body>
    @if (User.Identity is not null && User.Identity.IsAuthenticated)
    {
        <div class="ecotrack-layout">
            <div class="sidebar-overlay" id="sidebarOverlay"></div>

            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="bi bi-list fs-5"></i>
            </button>

            <aside class="ecotrack-sidebar" id="ecotrackSidebar">
                <div class="sidebar-header">
                    <img src="~/images/logo_ecobank.png" alt="Ecobank Logo" class="sidebar-logo-img" onerror="this.style.display='none'" />
                    <div>
                        <h6 class="m-0 fw-bold text-white">EcoTrack</h6>
                        <small class="text-white-50" style="font-size:0.7rem;">Ecobank-Togo</small>
                    </div>
                </div>

                <nav class="sidebar-nav">
                    @if (User.IsInRole("AdminPrincipal") || User.IsInRole("AdminTemporaire"))
                    {
                        <a asp-controller="Home" asp-action="Index" class="nav-link lien-accueil">
                            <span><i class="bi bi-speedometer2 me-2"></i> Tableau de bord</span>
                        </a>

                        <div class="nav-group-toggle" data-cible="sousMenuEmployes">
                            <span><i class="bi bi-people me-2"></i> Employés</span>
                            <i class="bi bi-chevron-down small"></i>
                        </div>
                        <div class="nav-submenu" id="sousMenuEmployes">
                            <a asp-controller="Employes" asp-action="Index">Liste des employés</a>
                            <a asp-controller="Employes" asp-action="Create">Nouvel employé</a>
                            <a asp-controller="Employes" asp-action="Rechercher">Rechercher un employé</a>
                            @if (User.IsInRole("AdminPrincipal"))
                            {
                                <a asp-controller="Utilisateurs" asp-action="TousLesUtilisateurs">Comptes &amp; mots de passe</a>
                            }
                        </div>

                        <div class="nav-group-toggle" data-cible="sousMenuActifs">
                            <span><i class="bi bi-laptop me-2"></i> Actifs</span>
                            <i class="bi bi-chevron-down small"></i>
                        </div>
                        <div class="nav-submenu" id="sousMenuActifs">
                            <a asp-controller="Actifs" asp-action="Index">Tous les actifs</a>
                            <a asp-controller="Actifs" asp-action="Create">Nouvel actif</a>
                            <a asp-controller="Actifs" asp-action="Index" asp-route-etat="Disponible">Disponibles</a>
                            <a asp-controller="Actifs" asp-action="Index" asp-route-etat="Attribue">Attribués</a>
                            <a asp-controller="Actifs" asp-action="Index" asp-route-etat="Deteriore">Détériorés</a>
                        </div>

                        <div class="nav-group-toggle" data-cible="sousMenuOrganisation">
                            <span><i class="bi bi-diagram-3 me-2"></i> Organisation</span>
                            <i class="bi bi-chevron-down small"></i>
                        </div>
                        <div class="nav-submenu" id="sousMenuOrganisation">
                            <a asp-controller="Agences" asp-action="Index">Agences</a>
                            <a asp-controller="Departements" asp-action="Index">Départements</a>
                            <a asp-controller="Divisions" asp-action="Index">Divisions</a>
                            <a asp-controller="Services" asp-action="Index">Services</a>
                            <a asp-controller="Unites" asp-action="Index">Unités</a>
                            <a asp-controller="CategoriesActifs" asp-action="Index">Catégories d'actifs</a>
                        </div>

                        <div class="nav-group-toggle" data-cible="sousMenuRapports">
                            <span><i class="bi bi-file-earmark-pdf me-2"></i> Analyses/Statistiques</span>
                            <i class="bi bi-chevron-down small"></i>
                        </div>
                        <div class="nav-submenu" id="sousMenuRapports">
                            <a asp-controller="Rapports" asp-action="Employe">Rapport par employé</a>
                            <a asp-controller="Rapports" asp-action="Departement">Rapport par agence, département, division, service ou unité</a>
                            <a asp-controller="Rapports" asp-action="PlageDates">Rapport par plage de dates</a>
                            <a asp-controller="Rapports" asp-action="Inventaire">Rapports sur les actifs</a>
                        </div>

                        @if (User.IsInRole("AdminPrincipal"))
                        {
                            <div class="nav-group-toggle" data-cible="sousMenuUtilisateurs">
                                <span><i class="bi bi-person-gear me-2"></i> Administration des comptes</span>
                                <i class="bi bi-chevron-down small"></i>
                            </div>
                            <div class="nav-submenu" id="sousMenuUtilisateurs">
                                <a asp-controller="Utilisateurs" asp-action="TousLesUtilisateurs">Tous les employés (modifier infos)</a>
                                <a asp-controller="Utilisateurs" asp-action="Index">Gestion des utilisateurs</a>
                                <a asp-controller="Utilisateurs" asp-action="Nommer">Nommer un employé admin</a>
                                <a asp-controller="Utilisateurs" asp-action="CreerTemporaire">Nouveau compte temporaire</a>
                                <a asp-controller="Utilisateurs" asp-action="Actions">Actions des utilisateurs</a>
                            </div>
                        }
                    }
                    else if (User.IsInRole("Employe"))
                    {
                        <a asp-controller="MonEspace" asp-action="Index" class="nav-link lien-accueil">
                            <span><i class="bi bi-person-workspace me-2"></i> Mon espace</span>
                        </a>
                    }

                    <div class="group-parametres-container">
                        <div class="nav-group-toggle" data-cible="sousMenuParametres">
                            <span><i class="bi bi-gear me-2"></i> Paramètres</span>
                            <i class="bi bi-chevron-down small"></i>
                        </div>
                        <div class="nav-submenu submenu-parametres" id="sousMenuParametres">
                            <a asp-controller="Compte" asp-action="Profil" class="lien-profil">
                                <i class="bi bi-person-circle me-2"></i> Profil
                            </a>
                            <form asp-controller="Compte" asp-action="Deconnexion" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-deconnexion-link">
                                    <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                                </button>
                            </form>
                        </div>
                    </div>
                </nav>
            </aside>

            <main class="ecotrack-content">
                @if (TempData["Succes"] is not null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Succes"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Erreur"] is not null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Erreur"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="container">
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script>
        // Rend tous les menus déroulants de l'appli cherchables au clavier (taper au lieu de défiler),
        // SAUF les menus en cascade (Agence -> Département -> Division -> Service -> Unité) : ceux-là
        // sont peuplés dynamiquement par du JavaScript qui modifie le <select> d'origine directement,
        // ce que Choices.js ne détecte pas après son initialisation.
        document.querySelectorAll('select.form-select').forEach(function (select) {
        if (select.matches('#selectAgence, #selectDepartement, #selectDivision, #selectService, #selectUnite')) {
        return;
        }
        new Choices(select, {
        searchEnabled: true,
        shouldSort: false,
        itemSelectText: '',
        searchPlaceholderValue: 'Taper pour chercher...'
        });
        });
    </script>
    <script>
        var sidebar = document.getElementById('ecotrackSidebar');
        var overlay = document.getElementById('sidebarOverlay');
        var toggle = document.getElementById('sidebarToggle');

        toggle?.addEventListener('click', function () {
        sidebar?.classList.toggle('ouverte');
        overlay?.classList.toggle('ouverte');
        });

        overlay?.addEventListener('click', function () {
        sidebar?.classList.remove('ouverte');
        overlay?.classList.remove('ouverte');
        });

        document.querySelectorAll('.nav-group-toggle').forEach(function (bouton) {
        bouton.addEventListener('click', function () {
        var cible = document.getElementById(bouton.dataset.cible);
        cible?.classList.toggle('ouvert');
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>