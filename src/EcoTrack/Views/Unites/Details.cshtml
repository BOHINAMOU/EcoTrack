@model EcoTrack.Models.Unite
@{
    ViewData["Title"] = "Détails de l'unité";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@Model.Nom</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>
<p class="text-muted">Service : @Model.Service?.Nom</p>

<h5 class="mb-3">Employés (@Model.Employes.Count)</h5>
<ul class="list-group">
    @foreach (var employe in Model.Employes)
    {
        <li class="list-group-item">
            <a asp-controller="Employes" asp-action="Details" asp-route-id="@employe.Id">@employe.Prenom @employe.Nom</a>
        </li>
    }
    @if (!Model.Employes.Any())
    {
        <li class="list-group-item text-muted">Aucun employé dans cette unité.</li>
    }
</ul>